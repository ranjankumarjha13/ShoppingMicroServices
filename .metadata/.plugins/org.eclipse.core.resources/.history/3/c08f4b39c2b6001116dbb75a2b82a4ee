spring:
  application:
    name: api-gateway

  main:
    web-application-type: reactive

  cloud:
    gateway:
      server:
        webflux:
          routes:

            - id: product-service
              uri: http://localhost:8081
              predicates:
                - Path=/api/products/**

            - id: cart-service
              uri: http://localhost:8082
              predicates:
                - Path=/api/cart/**

server:
  port: 8080

management:
  endpoint:
    gateway:
      access: read-only

  endpoints:
    web:
      exposure:
        include: health,info,gateway