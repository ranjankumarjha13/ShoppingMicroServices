spring:
  application:
    name: api-gateway

  cloud:
    gateway:
      routes:

        # Product Service
        - id: product-service
          uri: http://localhost:8081
          predicates:
            - Path=/api/products/**

        # Cart Service
        - id: cart-service
          uri: http://localhost:8082
          predicates:
            - Path=/api/cart/**

server:
  port: 8080

management:
  endpoints:
    web:
      exposure:
        include: health,info